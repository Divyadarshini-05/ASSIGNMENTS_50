public class Solution {
    // Precompute set bits for all numbers from 0 to 255
    private static final int[] bitTable = new int[256];
    
    static {
        for (int i = 0; i < 256; i++) {
            bitTable[i] = (i & 1) + bitTable[i >> 1];
        }
    }

    public int hammingWeight(int n) {
        // Break the 32-bit integer into four 8-bit chunks and look them up
        return bitTable[n & 0xff] +
               bitTable[(n >> 8) & 0xff] +
               bitTable[(n >> 16) & 0xff] +
               bitTable[(n >> 24) & 0xff];
    }
}
